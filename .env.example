# Option A: full connection string (Supabase / Neon / most cloud Postgres hosts give you this).
# When set, it takes priority over the DB_* vars below and SSL is enabled by default.
DATABASE_URL=

# Option B: discrete connection params (used only if DATABASE_URL is unset). Local dev default.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=touch_tech

# Force SSL on/off, overriding the defaults above ("true" or "false").
DB_SSL=

JWT_SECRET=change-this-to-a-long-random-string

APP_URL=http://localhost:3000
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-char-google-app-password
# Only set to true if you hit "unable to verify the first certificate" locally
# (common with antivirus/network TLS inspection on Windows). Never enable in production.
SMTP_INSECURE_TLS=false
