DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

JWT_SECRET=change-this-to-a-long-random-string

APP_URL=http://localhost:3000
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-char-google-app-password
# Only set to true if you hit "unable to verify the first certificate" locally
# (common with antivirus/network TLS inspection on Windows). Never enable in production.
SMTP_INSECURE_TLS=false

# From Vercel dashboard: Storage -> your Blob store -> BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=
